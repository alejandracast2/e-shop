# PostgreSQL
DB_NAME=e_shop
DB_USER=postgres
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=5432

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Application
DEFAULT_STORE_SLUG=example
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
PORT=4000

# Public OAuth client identifier (do not put a client secret here)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email codes (required in production; optional in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@eshop.local
